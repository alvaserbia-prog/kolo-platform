generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enumi ───────────────────────────────────────────────────────────────────

enum WalletType {
  USER
  KRUG
  PROTOKOL
}

enum KrugStatus {
  ACTIVE
  SUSPENDED
}

enum KrugOsnivanjeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PristupnicaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectType {
  PRIKUPLJANJE
  REDISTRIBUCIJA
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  UKLONJEN // Fondacija uklonila zbog povrede Uslova/Pravilnika/zakona
}

// Smer oglasa na Pijaci: PONUDA = oglašivač nudi dobro/uslugu (klasičan oglas),
// POTRAZNJA = oglašivač traži nekoga da uradi/napravi nešto („traži se").
// Kod POTRAZNJA budžet se uvek dogovara (cenaTip = DOGOVOR, bez iznosa).
enum TipOglasa {
  PONUDA
  POTRAZNJA
}

// Varijanta cene na oglasu Pijace (bira je oglašivač).
enum CenaTip {
  FIKSNA // jedan iznos
  RASPON // od–do
  DOGOVOR // bez iznosa, „po dogovoru"
}

enum TransactionType {
  TRANSFER
  EMISIJA_VERIFIKACIJA
  EMISIJA_NADZOR
  EMISIJA_DONACIJA
  EMISIJA_POKROVITELJ
  EMISIJA_KRUG_OSNIVANJE
  EMISIJA_KRUG_BONUS
  EMISIJA_PROGRAM
  UPIS_ZRNO
  OTPIS_ZRNO
  EMISIJA_OSNIVACKI
  EMISIJA_SADRZAJ // doprinos sadržaju platforme (Pravilnik čl. 15 t. 8, čl. 40a)
  EMISIJA_RAZMENA // doprinos razmeni — koraci 2–5 putanje prvog kruga (čl. 40a)
  PONISTENJE_PREPISA // protivzapis prepisa poništenog po prijavi razmene
  // Modul Deca: 500 POEN po sklopljenom prijateljstvu, obema stranama (čl. 14b).
  // Zaseban tip, da se u istoriji i u opticaju vidi šta je došlo iz dečjeg prostora.
  EMISIJA_PRIJATELJSTVO
  // Protivzapis Protokola pri raskidu prijateljstva i pri prelasku u punoletstvo
  // (čl. 14c, čl. 19). Nije „poništenje prepisa" — poništava se EMISIJA, pa opticaj
  // opada, dok prepis samo seli POEN između dva korisnička zapisa.
  OTPIS_PRIJATELJSTVO
  // Prevođenje punoletnog naloga u maloletni: poništenje svega što je Protokol
  // upisao tom nalogu, i skidanje POENA ljudima kojima je upisan povodom njegovih
  // potvrda. Poništava se EMISIJA, pa opticaj opada.
  OTPIS_PREVOD_U_MALOLETNI
  // Kolektivna nabavka: poništenje zapisa PO ISKORIŠĆENJU (Pravilnik čl. 14a).
  // Poništava se EMISIJA — Protokolov minus se smanjuje i opticaj opada. Nije
  // PONISTENJE_PREPISA: tamo se POEN seli između dva korisnička zapisa, ovde
  // nestaje iz sistema zato što je iskorišćen.
  OTPIS_NABAVKA
}

enum TipKorisnika {
  REGULARNI
  NOSILAC_ZRNA
  NEVERIFIKOVAN
}

// Operativna ovlašćenja (admin osa), nezavisna od članskog tipa (TipKorisnika).
// NONE = običan član; ADMIN = svakodnevna operativa; SUPERADMIN = sve + opasne
// radnje + verifikuje prve ljude (koren lanca jemstva).
enum AdminNivo {
  NONE
  ADMIN
  SUPERADMIN
}

enum ZrnoZahtevStatus {
  PENDING
  EXECUTED
  CANCELLED
}

enum ZrnoStatusAkcija {
  ZAKLJUCAJ
  OTKLJUCAJ
}

enum PredlogStatus {
  ACTIVE
  CLOSED
}

// Stanje izvršenja usvojene odluke Gornjeg Kola (čl. 17, 18)
enum IzvrsenjeStatus {
  ZA_IZVRSENJE // usvojeno, čeka izvršenje od strane Fondacije
  IZVRSENO // Fondacija izvršila odluku
  VETO_OBUSTAVLJENO // izvršenje obustavljeno zaštitnim vetom (čl. 18, 48)
}

// Vrsta predloga: obavezujuća odluka ili neobavezujuća dinarska preporuka (čl. 20)
enum PredlogVrsta {
  ODLUKA
  DINARSKA_PREPORUKA
  // Izbor jedne mogućnosti između više ponuđenih (Gornje Kolo čl. 8 st. 4).
  // Predmet nabavke je dinarsko pitanje, pa ovaj tip NIKAD ne ide u izvršenje
  // po čl. 17 — kao ni DINARSKA_PREPORUKA. Stvara ga isključivo server.
  IZBOR_NABAVKE
}

// Obrazložen odgovor UO na usvojenu dinarsku preporuku (čl. 20)
enum UoOdgovor {
  PRIHVACENO
  ODBIJENO
}

enum ProgramType {
  PED
  PODRSKA_MAJKAMA
  PODRSKA_STARIJIMA
  POSEBNA_BRIGA
  SKOLOVANJE
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum PotvrdaStatus {
  CEKA
  POTVRDJENO
  ODBIJENO
}

enum EvidencijaStatus {
  PENDING
  APPROVED
  REJECTED
  EMITTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  EXCLUDED
}

enum SistemskoStatus {
  NACRT
  U_SLANJU
  POSLATO
  PREKINUTO
}

enum DonationStatus {
  PENDING
  CONFIRMED
}

enum VrstaDonacije {
  NOVAC
  ROBA
  USLUGE
}

enum PokroviteljPrijavaStatus {
  CEKA_POTPIS
  POTPISANA
  POTVRDJENA
  ODBIJENA
}

enum OglasStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum OglasSource {
  FONDACIJA
  KRUG
  PROJEKAT
}

enum OglasPrijavaStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Modeli ───────────────────────────────────────────────────────────────────

model User {
  id                               String                    @id @default(uuid())
  email                            String?                   @unique
  passwordHash                     String?
  oauthProvider                    String?
  oauthId                          String?
  oauthPending                     Boolean                   @default(false)
  pseudonim                        String                    @unique
  // Pseudonim u malim slovima — jedini ključ po kome se pseudonim traži i po kome
  // se čuva jedinstvenost. Bez ovoga bi "Marko" i "marko" bila dva različita naloga
  // (Postgres `@unique` je osetljiv na veličinu slova), što je i rupa za imitaciju i
  // dvosmislenost otkad adresa profila glasi `/profil/<pseudonim>`. Prikazuje se
  // uvek `pseudonim` (sa velikim slovima kako ga je korisnik upisao).
  // Održava se ISKLJUČIVO preko `src/lib/pseudonim.ts` — ne upisivati ručno.
  pseudonimLower                   String                    @unique
  // Trajni donatorski broj člana — osnova poziva na broj (model 97) za uplate
  // (IPS QR + klasična uplatnica). Redni broj po datumu registracije (backfill u
  // migraciji), novi nalozi dobijaju sledeći iz sekvence. Ostaje i posle
  // anonimizacije naloga (neidentifikujući, kao i interni id).
  donatorskiBroj                   Int                       @unique @default(autoincrement())
  status                           UserStatus                @default(ACTIVE)
  suspendedAt                      DateTime?
  suspendedReason                  String?
  verified                         Boolean                   @default(false)
  verifiedAt                       DateTime?
  tipKorisnika                     TipKorisnika              @default(NEVERIFIKOVAN)
  admin                            AdminNivo                 @default(NONE)
  // Oznaka početnog nosioca ZRNA (osnivač). Zaseban marker pored tipKorisnika —
  // status NOSILAC_ZRNA može steći i običan korisnik upisom ZRNA, pa nije pouzdan
  // pokazatelj osnivača. Osnivač NE sme da verifikuje drugog osnivača (anti-malverzacija).
  jeOsnivac                        Boolean                   @default(false)
  indeksStvarnosti                 Int                       @default(0)
  slotoviPotroseni                 Int                       @default(0)
  // Upravni odbor je utvrdio da iza naloga ne stoji stvarna osoba, ili da nalog nije
  // jedinstven (dokaz stvarnosti 4.2.0, čl. 18). Takav nalog nikoga ne može poznavati,
  // pa padaju SVE verifikacije koje ga dodiruju — i primljene i obavljene (čl. 20).
  // Kaskada se time zaustavlja na prvom nalogu koji NIJE ovako označen: stvaran čovek
  // gubi samo vezu ka lažnom nalogu, a sopstvene verifikacije zadržava.
  utvrdjenNepostojeci              DateTime?
  pocetnaEmisijaIzvrsena           Boolean                   @default(false)
  pseudonimChangedAt               DateTime?
  // "Viđeno" vremena za sidebar badge-eve: badge broji samo stavke novije od ovog
  // trenutka. Postavlja se kad korisnik otvori odgovarajući tab → badge ide na 0.
  vidjenoNovcanikAt                DateTime?
  vidjenoPijacaAt                  DateTime?
  vidjenoPocetnaAt                 DateTime?
  // Kad je čovek prvi put video vodič `/dobrodosli`. Dok je NULL, prva prijava
  // vodi na vodič — isto što registracija radi odmah po otvaranju naloga.
  // Do sada je „prvi prolaz" živeo samo u `sessionStorage` pregledača, pa vodič
  // nije video ni onaj ko se registruje pa zatvori prozor, ni nalog vraćen na
  // dan registracije (server ne može da dopre do memorije pregledača).
  // Zatečeni nalozi su u migraciji popunjeni tekućim vremenom — vodič im se ne
  // otvara naknadno.
  vodicVidjenAt                    DateTime?
  // ─── Modul Deca (Pravilnik o Modulu Deca) ─────────────────────────────────
  // Nenulto samo kod maloletnih korisnika. Jedini izvor uzrasta; posle upisa se ne
  // menja (čl. 7) — roditeljska izjava je jedina provera godina kojom sistem
  // raspolaže.
  //
  // 🔴 SME da bude NULL i kod maloletnog naloga: dete koje se registrovalo samo
  // ne unosi datum rođenja — upisuje ga roditelj pri preuzimanju naloga. Sve što
  // čita ovo polje mora da podnese `null` (uzrast nepoznat).
  datumRodjenja                    DateTime?                 @db.Date
  // Izvedeno iz `datumRodjenja`, ali indeksabilno i jeftino u `where` — svaki javni
  // upit mora da isključi decu, a računanje datuma po redu to ne bi podnelo.
  // 🔴 Oba polja se pišu ISKLJUČIVO kroz `poljaDeteta()` u `src/lib/protokol/deca.ts`.
  maloletan                        Boolean                   @default(false)
  // Roditelji (čl. 4). Zaseban model, jer dete ima najviše DVA roditelja i oba
  // imaju ista ovlašćenja — kolona na nalogu bi jednog činila glavnim, a drugog
  // dopisanim. Prazan skup znači „dete na čekanju": nalog postoji, veza ne.
  roditeljstvaKaoDete              Roditeljstvo[]            @relation("RoditeljstvoDete")
  roditeljstvaKaoRoditelj          Roditeljstvo[]            @relation("RoditeljstvoRoditelj")
  // Poziv upućen roditelju pri samostalnoj registraciji deteta. Najviše jedan
  // živ po detetu (`@unique` na `deteId`).
  roditeljPoziv                    RoditeljPoziv?
  // Prekidač iz čl. 10 st. 2: komunikacija i razmena maloletnog korisnika sa
  // punoletnim korisnicima. Isključen pri otvaranju naloga, povlači se u svakom
  // trenutku. Stoji na DETETU, a menja ga bilo koji od roditelja.
  dozvolaOdrasli                   Boolean                   @default(false)
  // Škola koju maloletni korisnik pohađa (Pravilnik o učešću dece, čl. 7). Bira je
  // SÁMO dete, sa spiska u `src/lib/skole-srbije.ts` — ovde stoji ŠIFRA, nikad
  // naziv, jer isto ime nosi preko trideset škola u Srbiji.
  //
  // 🔴 Briše se na dva mesta i oba se lako previde: pri prelasku u punoletni nalog
  // (`punoletstvo.ts` — inače punoletan čovek zauvek ostaje u brojanju svoje
  // osnovne škole) i pri gašenju naloga (čl. 34).
  skolaSifra                       String?
  // Nosi rok od 30 dana između dve promene. 🔴 PRVA postavka nije promena i ostavlja
  // ovo polje prazno — dete koje tek bira školu ne čeka ništa. Istorija škola se NE
  // čuva (minimizacija): pamti se samo tekuća vrednost i trenutak poslednje izmene.
  skolaPromenjenaAt                DateTime?
  // Prelaz u punoletstvo (Modul Deca, Glava VI). Dva odvojena stuba, jer se dešavaju
  // mesec dana jedan od drugog i oba moraju biti idempotentna: obaveštenje se šalje
  // jednom, obrada se izvodi jednom.
  punoletstvoNajavaAt              DateTime?
  punoletstvoObradjenAt            DateTime?
  potvrdeRoditeljstvaZaMene        RoditeljstvoPotvrda[]     @relation("PotvrdaDete")
  potvrdeRoditeljstvaKojeDajem     RoditeljstvoPotvrda[]     @relation("PotvrdaPotvrdjivac")
  prijateljstvaA                   Prijateljstvo[]           @relation("PrijateljA")
  prijateljstvaB                   Prijateljstvo[]           @relation("PrijateljB")
  prijateljstvaRaskinuta           Prijateljstvo[]           @relation("PrijateljstvoRaskinuo")
  prijateljTokeni                  PrijateljToken[]
  prijaveporuka                    PrijavaPoruke[]           @relation("PrijaviocPoruke")
  prijavljenePoruke                PrijavaPoruke[]           @relation("PrijavljeniPoruke")
  memberHash                       String                    @unique
  location                         String?
  telefon                          String?
  avatar                           String?
  // Izabrani jezik korisnika (next-intl locale): "sr" | "sr-Cyrl" | "en" | "hu".
  // Koristi se za jezik notifikacija/email-ova i podrazumevani prikaz po prijavi.
  jezik                            String                    @default("sr")
  // Email obaveštenja o događajima koji traže pažnju (verifikacija, odluke o
  // prijavama, nove poruke...). Opt-out: podrazumevano uključeno, korisnik gasi
  // u profilu ili linkom iz mejla. NE utiče na sistemske mejlove bez kojih nalog
  // ne radi (reset lozinke) — oni idu uvek.
  emailObavestenja                 Boolean                   @default(true)
  // Trajni token za odjavu iz mejlova bez prijave (link u podnožju svakog mejla).
  // Generiše se lenjo, pri prvom slanju. Ne otkriva identitet ni email adresu.
  emailOdjavaToken                 String?                   @unique
  deaktiviranAt                    DateTime?
  pristankiPolitike                PolitikaPrihvatanje[]
  pristankiPravilnika              PravilnikPrihvatanje[]
  osnivacZapis                     Osnivac?                  @relation("Osnivac")
  kreiraniTroskovi                 FondacijaTrosak[]         @relation("KreiraoTrosak")
  wallet                           Wallet?
  podaci                           UserPodaci?
  donations                        DonationRecord[]
  kreiraniPokrovitelji             Pokrovitelj[]             @relation("AdminKreiraoP")
  vlasnikPokrovitelja              Pokrovitelj[]             @relation("VlasnikP")
  evidentiraniDoprinosi            PokroviteljDoprinos[]     @relation("EvidentiraoDoprinos")
  pokroviteljBonusi                PokroviteljBonusEmisija[] @relation("PrimalacBonusa")
  kreiraniOglasi                   DoprinosOglas[]           @relation("KreiraniOglasi")
  oglasPrijave                     OglasPrijava[]            @relation("OglasPrijave")
  oglasEvidencije                  OglasEvidencija[]         @relation("OglasEvidencije")
  listings                         MarketplaceListing[]      @relation("SellerListings")
  purchases                        MarketplaceListing[]      @relation("BuyerListings")
  prijaveOglasa                    PrijavaOglasa[]           @relation("PrijaviocOglasa")
  prijaveRazmene                   PrijavaRazmene[]          @relation("PrijaviocRazmene")
  prijavljeneRazmene               PrijavaRazmene[]          @relation("ProtivRazmene")
  doprinosSadrzaju                 DoprinosSadrzaju?
  doprinosiRazmeni                 DoprinosRazmeni[]
  oglasUpiti                       OglasUpit[]
  praceneKategorije                FollowedCategory[]
  krugClanstva                     KrugClanstvo[]
  pristupnice                      KrugPristupnica[]
  osnivanjeZahtevi                 KrugOsnivanjeZahtev[]     @relation("Inicijator")
  programEnrollments               ProgramEnrollment[]
  programPotvrde                   ProgramPotvrda[]          @relation("VerifikatorPotvrda")
  zrnoStanje                       ZrnoStanje?
  zrnoUpisZahtevi                  ZrnoUpisZahtev[]
  zrnoOtpisZahtevi                 ZrnoOtpisZahtev[]
  zrnoStatusZahtevi                ZrnoStatusZahtev[]
  delegiraoKome                    ZrnoDelegacija?           @relation("Delegator")
  delegatZa                        ZrnoDelegacija[]          @relation("Delegat")
  zakazanZaDelegata                ZrnoDelegacija[]          @relation("ZakazaniDelegat")
  kreiraniPredlozi                 GlasanjePredlog[]
  glasovi                          GlasanjeGlas[]
  auditLogs                        AuditLog[]                @relation("AdminActions")
  aktivnosti                       AktivnostLog[]
  notifikacije                     Notifikacija[]
  pushPretplate                    PushPretplata[]
  konverzacije1                    Konverzacija[]            @relation("KonvUser1")
  konverzacije2                    Konverzacija[]            @relation("KonvUser2")
  porukePoslate                    Poruka[]                  @relation("PorukePostavljene")
  prigovori                        PrigovorNaOdluku[]
  blogObjave                       BlogPost[]                @relation("BlogAutor")
  chatPoruke                       ChatMessage[]             @relation("ChatPoruke")
  passwordResetTokens              PasswordResetToken[]
  emailPotvrde                     EmailPotvrda[]
  verifikacijeKojeSamObavio        VerifikacionaVeza[]       @relation("Verifikator")
  verifikacijeKojeSuMeVerifikovale VerifikacionaVeza[]       @relation("Verifikovani")
  nadzori                          VerifikacionaVeza[]       @relation("Nadzornik")
  nadzorZapisi                     NadzorZapis[]             @relation("NadzorZapisi")
  predmetiReseni                   NadzorniPredmet[]         @relation("PredmetiReseni")
  verifikacijaTokeni               VerifikacijaToken[]
  zabranjenaZona                   VerifikacionaZona[]       @relation("ZonaVlasnik")
  uTudjimZonama                    VerifikacionaZona[]       @relation("ZonaZabranjeni")
  zahteviZaJemstvo                 ZahtevZaJemstvo[]
  prepoznavanja                    Prepoznavanje[]
  pokroviteljPrijave               PokroviteljPrijava[]      @relation("PodnosilacPrijave")
  prijavljeniBagovi                Bug[]                     @relation("PrijaviocBaga")
  sistemskaObavestenja             SistemskoObavestenje[]    @relation("KreiraoObavestenje")
  pseudonimIstorija                PseudonimIstorija[]
  predlogNabavke                   PredlogNabavke?
  naziviDobara                     NazivDobra[]              @relation("KreiraoNaziv")
  nabavkaPrijave                   NabavkaPrijava[]
  projekatTroskovi                 ProjekatTrosak[]          @relation("KreiraoProjekatTrosak")
  createdAt                        DateTime                  @default(now())
  updatedAt                        DateTime                  @updatedAt

  // Svaki javni upit filtrira decu; bez indeksa bi to bio pun prolaz kroz tabelu.
  @@index([maloletan])
  // Noćni posao punoletstva traži maloletne naloge po datumu rođenja.
  @@index([maloletan, datumRodjenja])
  // Ranglista škola grupiše decu po šifri škole. Prvi član indeksa je `maloletan`
  // zato što upit UVEK počinje od njega — punoletan nalog školu nema.
  @@index([maloletan, skolaSifra])
}

/// Veza roditelj — dete (Modul Deca, čl. 4 i 5).
///
/// Dete ima najviše dva roditelja i **oba imaju ista ovlašćenja**: prekidač za
/// odrasle, uklanjanje oglasa, uvid u razgovore sa punoletnim licima i brisanje
/// naloga. Zato veza živi u zasebnoj tabeli, a ne kao kolona na nalogu deteta —
/// kolona bi jednog roditelja činila nosiocem, a drugog dopisanim.
///
/// 🔴 Prazan skup redova za dete NIJE greška u podacima nego stanje: „dete na
/// čekanju" je nalog koji se registrovao sam i čeka da ga roditelj preuzme.
model Roditeljstvo {
  id         String   @id @default(uuid())
  deteId     String
  dete       User     @relation("RoditeljstvoDete", fields: [deteId], references: [id], onDelete: Cascade)
  roditeljId String
  roditelj   User     @relation("RoditeljstvoRoditelj", fields: [roditeljId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([deteId, roditeljId])
  @@index([deteId])
  @@index([roditeljId])
}

/// Poziv roditelju pri samostalnoj registraciji deteta (Modul Deca, čl. 4a).
///
/// Dete unosi svoj pseudonim i **email roditelja**; datum rođenja ne unosi — njega
/// upisuje roditelj pri preuzimanju. Roditelju stiže poruka sa tri radnje: preuzmi
/// nalog, ovo nije moje dete, obriši nalog.
///
/// Dva roka, i namerno su različita:
///  - `tokenDo` (sedam dana) — koliko važi jednokratni link iz poruke;
///  - `brisanjeDo` (četrnaest dana od registracije) — koliko nalog uopšte sme da
///    postoji bez preuzimanja. Dete na čekanju je lice čiji se podaci obrađuju PRE
///    pribavljenog pristanka roditelja, i to ne sme da traje neograničeno.
///
/// `kod` je rezervni put: šest cifara vidljivih u profilu deteta, koje roditelj
/// unosi uz pseudonim kad poruka ne stigne ili link istekne. Zato traje koliko i
/// `brisanjeDo`, a ne koliko token.
model RoditeljPoziv {
  id           String    @id @default(uuid())
  deteId       String    @unique
  dete         User      @relation(fields: [deteId], references: [id], onDelete: Cascade)
  // Podatak o TREĆEM LICU koji unosi dete. Ne proverava se i ne koristi se ni za
  // šta osim za slanje jedne poruke — zato u njoj stoji samo pseudonim deteta,
  // nikad njegovo pravo ime.
  email        String
  token        String    @unique
  kod          String
  tokenDo      DateTime
  brisanjeDo   DateTime
  iskoriscenAt DateTime?
  // „Ovo nije moje dete" — nalog ostaje do isteka `brisanjeDo`, ali poziv je mrtav
  // i poruka se ne šalje ponovo na istu adresu.
  odbijenAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([brisanjeDo])
}

// ─── Modul Deca — potvrda roditeljstva (Pravilnik o Modulu Deca, čl. 6) ──────
//
// Nalog deteta radi od trenutka otvaranja (čl. 4 st. 1). Lica koja su potvrdila
// stvarnost roditelja imaju TRIDESET DANA da potvrde da roditelj ima dete tog
// uzrasta. Ko se ne izjasni, gubi sopstvenu potvrdu stvarnosti tog roditelja:
// poništavaju se zapisi POEN-a evidentirani povodom te potvrde i oslobađa mu se
// verifikacioni slot (čl. 6 st. 3).
//
// Potvrda se daje ZA SVAKO DETE POSEBNO — otud `@@unique([deteId, potvrdjivacId])`,
// a ne po roditelju. Čovek sa četvoro dece traži četiri odvojena izjašnjenja.
//
// Veza ka `VerifikacionaVeza` se NE čuva: veza se pri poništenju briše, pa bi strani
// ključ ostao viseći. Merodavan je par (potvrđivač, roditelj), koji je u
// `VerifikacionaVeza` ionako jedinstven.
model RoditeljstvoPotvrda {
  id            String                    @id @default(uuid())
  deteId        String
  dete          User                      @relation("PotvrdaDete", fields: [deteId], references: [id], onDelete: Cascade)
  potvrdjivacId String
  potvrdjivac   User                      @relation("PotvrdaPotvrdjivac", fields: [potvrdjivacId], references: [id])
  status        RoditeljstvoPotvrdaStatus @default(CEKA)
  // Obavezno uz osporavanje (čl. 6 st. 6). Uz potvrdu se ne traži.
  obrazlozenje  String?
  rokDo         DateTime
  odgovorAt     DateTime?
  createdAt     DateTime                  @default(now())

  @@unique([deteId, potvrdjivacId])
  @@index([potvrdjivacId, status])
  @@index([status, rokDo])
}

enum RoditeljstvoPotvrdaStatus {
  CEKA
  POTVRDIO
  // Osporavanje postojanja deteta — ide Upravnom odboru (čl. 6 st. 6).
  OSPORIO
  // Rok od 30 dana istekao bez izjašnjenja; potvrda stvarnosti roditelja je pala.
  // Izjašnjenje dato posle roka ne otklanja nastupelo poništenje (čl. 6 st. 4).
  ISTEKLA
}

/// Napušteni pseudonimi. Dve svrhe, obe posledica toga što pseudonim stoji u
/// adresi profila (`/profil/<pseudonim>`):
///
///  1. **Stari linkovi ostaju živi.** Posle preimenovanja `/profil/StaroIme` i
///     dalje vodi na istog čoveka (stranica potom prepiše adresu u novu).
///  2. **Napušteno ime se ne može preuzeti.** Bez ovoga bi neko drugi uzeo
///     oslobođeni pseudonim, pa bi ranije podeljeni link tiho vodio na DRUGU
///     osobu — što je gore od mrtvog linka, jer izgleda ispravno.
///
/// Red se briše kad se korisnik vrati na svoje staro ime i pri gašenju naloga
/// (čl. 34 — anonimizacija; napušteni pseudonim je i dalje trag o nalogu).
model PseudonimIstorija {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pseudonim      String
  pseudonimLower String   @unique
  promenjenAt    DateTime @default(now())

  @@index([userId])
}

/// Cirkularno SISTEMSKO obaveštenje svim korisnicima — izmene Uslova/Politike
/// (Uslovi čl. 40, Politika čl. 16), planirani zastoj duži od 24h (Uslovi čl. 33)
/// i slična obaveštenja koja Fondacija duguje korisnicima.
///
/// NE poštuje `User.emailObavestenja` — to je obaveza iz akata, ne izbor. Zato je
/// `pravniOsnov` obavezan i upisuje se u audit log: sistemska pošta bez osnova iz
/// akata je bilten, a bilten traži zaseban pristanak i dopunu Politike (čl. 8,
/// gde je Resend deklarisan isključivo za sistemska obaveštenja).
///
/// Slanje je nastavljivo: `kursorId` je poslednji obrađeni `User.id` u stabilnom
/// redosledu po id-u, pa ponovno pokretanje nastavlja odatle i ne šalje dvaput.
model SistemskoObavestenje {
  id          String          @id @default(uuid())
  naslov      String
  tekst       String
  /// Relativna putanja u aplikaciji (npr. "/uslovi"), opciono.
  link        String?
  /// Odredba akta iz koje proizlazi obaveza slanja (npr. "Uslovi čl. 40").
  pravniOsnov String
  status      SistemskoStatus @default(NACRT)
  ukupno      Int             @default(0)
  poslato     Int             @default(0)
  neuspesno   Int             @default(0)
  kursorId    String?
  kreiraoId   String
  kreirao     User            @relation("KreiraoObavestenje", fields: [kreiraoId], references: [id])
  createdAt   DateTime        @default(now())
  pokrenutoAt DateTime?
  zavrsenoAt  DateTime?

  @@index([status, createdAt(sort: Desc)])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Potvrda imejl adrese koju maloletni korisnik sam upiše (Pravilnik o učešću dece,
/// čl. 7 — školu i ostale dobrovoljne podatke navodi sámo dete).
///
/// 🔴 Adresa se NE upisuje u `User.email` dok se ne potvrdi klikom na link poslat
/// NA NJU. Bez tog koraka jedna omaška u kucanju predaje ključ od dečjeg naloga
/// nepoznatoj osobi: tok „zaboravljena lozinka" šalje link upravo na upisanu
/// adresu. Do potvrde adresa živi samo u ovom redu i ne radi ništa.
///
/// Red se ne briše posle upotrebe (`usedAt`), da se isti link ne bi upotrebio
/// dvaput; čisti ga isti posao koji čisti istekle tokene.
model EmailPotvrda {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserPodaci {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  punoIme   String?
  opis      String?
  updatedAt DateTime @updatedAt

  // Vidljivost profila
  prikaziLokaciju     Boolean @default(true)
  prikaziOpis         Boolean @default(false)
  prikaziPunoIme      Boolean @default(false)
  prikaziTelefon      Boolean @default(false)
  prikaziBilans       Boolean @default(true)
  prikaziZrno         Boolean @default(true)
  prikaziRangDonacija Boolean @default(true)
  prikaziOglase       Boolean @default(true)
}

model Wallet {
  id         String        @id @default(uuid())
  userId     String?       @unique
  user       User?         @relation(fields: [userId], references: [id])
  krugId     String?       @unique
  krug       Krug?         @relation("KrugWallet", fields: [krugId], references: [id])
  balance    Int           @default(0)
  type       WalletType
  outgoingTx Transaction[] @relation("FromWallet")
  incomingTx Transaction[] @relation("ToWallet")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Transaction {
  id            String          @id @default(uuid())
  fromWalletId  String?
  fromWallet    Wallet?         @relation("FromWallet", fields: [fromWalletId], references: [id])
  toWalletId    String
  toWallet      Wallet          @relation("ToWallet", fields: [toWalletId], references: [id])
  amount        Int
  type          TransactionType
  /**
   * Gotov srpski opis — UVEK popunjen (rezerva i stari redovi).
   */
  description   String?
  /**
   * Ključ u messages/*.json, npr. "transakcije.verifikacija".
   */
  opisKljuc     String?
  /**
   * Vrednosti za {pseudonim}, {iznos}, {krug}...
   */
  opisParametri Json?
  createdAt     DateTime        @default(now())

  /// Prijava da razmena povodom ovog prepisa nije ispunjena (najviše jedna).
  prijavaRazmene PrijavaRazmene?
}

model Krug {
  id             String            @id @default(uuid())
  name           String            @unique
  description    String?
  location       String?
  status         KrugStatus        @default(ACTIVE)
  wallet         Wallet?           @relation("KrugWallet")
  memberships    KrugClanstvo[]
  pristupnice    KrugPristupnica[]
  projects       KrugProjekat[]
  bonusLogs      KrugBonusLog[]
  doprinosOglasi DoprinosOglas[]   @relation("KrugOglasi")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model KrugClanstvo {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  krugId   String
  krug     Krug      @relation(fields: [krugId], references: [id])
  isAdmin  Boolean   @default(false)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@index([userId, leftAt])
  @@index([krugId, leftAt])
}

model KrugOsnivanjeZahtev {
  id              String              @id @default(uuid())
  name            String
  description     String?
  location        String?
  inicijatorId    String
  inicijator      User                @relation("Inicijator", fields: [inicijatorId], references: [id])
  osnivaci        String[]
  status          KrugOsnivanjeStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime            @default(now())
}

model KrugPristupnica {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  krugId    String
  krug      Krug              @relation(fields: [krugId], references: [id])
  status    PristupnicaStatus @default(PENDING)
  createdAt DateTime          @default(now())

  @@unique([userId, krugId])
}

model KrugProjekat {
  id          String      @id @default(uuid())
  krugId      String
  krug        Krug        @relation(fields: [krugId], references: [id])
  type        ProjectType
  title       String
  description String
  status      String      @default("ACTIVE")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model KrugBonusLog {
  id        String   @id @default(uuid())
  krugId    String
  krug      Krug     @relation(fields: [krugId], references: [id])
  threshold Int
  amount    Int
  createdAt DateTime @default(now())

  // Svaki prag rasta kruga se isplaćuje tačno jednom (race-safe rezervacija praga).
  @@unique([krugId, threshold])
}

model MarketplaceListing {
  id             String        @id @default(uuid())
  sellerId       String
  seller         User          @relation("SellerListings", fields: [sellerId], references: [id])
  buyerId        String?
  buyer          User?         @relation("BuyerListings", fields: [buyerId], references: [id])
  // Smer oglasa (ponuda vs potražnja). Kod POTRAZNJA je cenaTip uvek DOGOVOR.
  tip            TipOglasa     @default(PONUDA)
  title          String
  description    String
  // Cena ima tri varijante (bira ih oglašivač):
  //  - FIKSNA  → jedan iznos u `price` (cenaDo = null)
  //  - RASPON  → `price` = donja granica, `cenaDo` = gornja granica
  //  - DOGOVOR → bez iznosa („po dogovoru"); price = cenaDo = null
  // `price` (donja granica/fiksna cena) ostaje numerička osnova za sortiranje i min/max filter.
  cenaTip        CenaTip       @default(FIKSNA)
  price          Int?
  cenaDo         Int?
  // Opciona jedinica mere za cenu (kom, kg, g, l, ml, m, pak) i stanje na zalihama.
  // Oba su informativna — ne utiču na tok kupovine (oglas se i dalje kupuje u celosti).
  jedinica       String?
  kolicina       Int?
  category       String
  images         String[]
  location       String?
  phone          String?
  status         ListingStatus @default(ACTIVE)
  soldAt         DateTime?
  // Broj otvaranja stranice oglasa. Ne broje se pregledi samog oglašivača, a
  // isti posetilac se broji jednom dnevno (guard je u pretraživaču). Vidi ga
  // SAMO oglašivač — povratna informacija da oglas nije otišao u prazno.
  pregledi       Int           @default(0)
  // Uklanjanje od strane Fondacije (Uslovi čl. 21 st. 2 i čl. 25 st. 2). Razlog je
  // obavezan jer se korisniku mora saopštiti — nije opcioni komentar za internu upotrebu.
  uklonjenAt     DateTime?
  uklonjenRazlog String?
  uklonioId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  prijave      PrijavaOglasa[]
  doprinosi    DoprinosSadrzaju[]
  upiti        OglasUpit[]
  poruke       Poruka[]           @relation("PorukaOglas")
  povodKonverz Konverzacija[]     @relation("KonvPovod")

  @@index([status, category, createdAt])
  @@index([status, tip, createdAt])
}

/**
 * Prijava oglasa od strane korisnika (Uslovi čl. 25 st. 2 — Fondacija može ukloniti
 * sadržaj „koji je prijavljen od strane drugih korisnika kao problematičan").
 * Jedan korisnik može prijaviti isti oglas samo jednom (@@unique) — inače je
 * brojač prijava merilo glasnosti, a ne ozbiljnosti.
 */
model PrijavaOglasa {
  id          String              @id @default(uuid())
  oglasId     String
  oglas       MarketplaceListing  @relation(fields: [oglasId], references: [id], onDelete: Cascade)
  prijaviocId String
  prijavioc   User                @relation("PrijaviocOglasa", fields: [prijaviocId], references: [id])
  razlog      PrijavaRazlog
  opis        String?
  status      PrijavaOglasaStatus @default(OTVORENA)
  resioId     String?
  resenoAt    DateTime?
  createdAt   DateTime            @default(now())

  @@unique([oglasId, prijaviocId])
  @@index([status, createdAt(sort: Desc)])
  @@index([oglasId])
}

/**
 * Razlozi prijave — prate zabrane iz Uslova čl. 20, 21, 22 i 24.
 */
enum PrijavaRazlog {
  ZABRANJENO_DOBRO // čl. 21 — dobra/usluge čiji je promet zabranjen
  OBMANA // čl. 20 — lažan ili obmanjujuć prikaz dobra/usluge
  UVREDLJIVO // čl. 22 — uznemiravanje, pretnje, diskriminacija
  LICNI_PODACI // čl. 24 — lični podaci trećih lica
  PREVARA // čl. 24 — prevara, manipulacija, nezakonita aktivnost
  DRUGO
}

/// Šifre razloga za prijavu poruke iz Pričaonice (Uslovi čl. 25).
///
/// 🔴 Prijava je 04.09.2026. UKLONJENA iz dečje sobe (odluka vlasnika), pa se nove
/// prijave upisuju samo iz sobe odraslih. Tri šifre mamljenja (TRAZI_SLIKE,
/// TRAZI_SUSRET, LAZE_UZRAST) OSTAJU: nose ih zatečeni redovi upisani dok je dugme
/// radilo, a admin ekran mora da ume da ih prikaže. Brisanje vrednosti oborilo bi
/// prikaz tih prijava.
///
/// 🔴 TRAZI_SLIKE, TRAZI_SUSRET i LAZE_UZRAST stoje odvojeno namerno: to su
/// obrasci mamljenja, i pod jednom zbirnom šifrom „neprimereno" ne bi se videli.
enum PrijavaPorukeRazlog {
  VREDJANJE // uvrede, pretnje, maltretiranje
  TRAZI_SLIKE // traži fotografije
  TRAZI_SUSRET // traži susret ili kontakt van Platforme
  LAZE_UZRAST // sumnja da iza naloga nije dete
  NEPRIMEREN_SADRZAJ // vulgaran ili uvredljiv sadržaj
  LICNI_PODACI // lični podaci trećih lica
  PREVARA // prevara, obmana, nezakonita aktivnost
  OSTALO
}

enum PrijavaOglasaStatus {
  OTVORENA
  RESENA // oglas uklonjen povodom prijave
  ODBACENA // pregledano, nema povrede
}

/**
 * Prijava da razmena povodom prepisa POEN-a nije ispunjena.
 * Prepis je ažuriranje evidencije između dva zapisa (Pravilnik čl. 14, 16) i
 * ne poništava se sam od sebe — za razmenu odgovaraju sami korisnici po
 * obligacionom pravu, a Fondacija nije strana u tom odnosu (Uslovi čl. 22).
 * Zato ovo NIJE automatski povraćaj nego evidencija prijave o kojoj Fondacija
 * odlučuje: može da poništi prepis protivzapisom ili da prijavu odbaci.
 * Prijavljuje ISKLJUČIVO onaj ko je POEN prepisao — samo on je nešto izgubio.
 * Jedna prijava po prepisu (@@unique na `transakcijaId`): druga prijava nad
 * istim prepisom ne bi bila nov podatak nego ponovljen pritisak.
 */
model PrijavaRazmene {
  id            String      @id @default(uuid())
  transakcijaId String      @unique
  transakcija   Transaction @relation(fields: [transakcijaId], references: [id], onDelete: Cascade)

  /// Onaj ko je prepisao POEN i nije dobio dogovoreno.
  prijaviocId String
  prijavioc   User   @relation("PrijaviocRazmene", fields: [prijaviocId], references: [id])
  /// Druga strana razmene — onaj kome je POEN prepisan.
  protivId    String
  protiv      User   @relation("ProtivRazmene", fields: [protivId], references: [id])

  opis   String
  status PrijavaRazmeneStatus @default(OTVORENA)

  /// Obrazloženje odluke Fondacije — obavezno u oba ishoda, ide prijaviocu.
  odluka  String?
  resioId String?
  resenAt DateTime?
  /// Koliko je POEN-a stvarno vraćeno. Može biti manje od prepisanog iznosa i
  /// može biti 0: zapis primaoca ne sme u minus (Pravilnik čl. 14), pa se vraća
  /// najviše ono što na njemu zatekne.
  vraceno Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([prijaviocId])
}

enum PrijavaRazmeneStatus {
  OTVORENA
  PONISTENA // prepis poništen protivzapisom (u celini ili delimično)
  ODBACENA // pregledano, prepis ostaje
}

/// Stanje doprinosa sadržaju platforme (Pravilnik čl. 40a st. 3).
/// ZABELEZEN nije zapis POEN-a — do evidentiranja ne ulazi ni u jedno stanje
/// računa, ni u opticaj, ni u javne agregate. To razdvajanje je pravno srce
/// kanala: drži zero-sum i sve pragove sistema van domašaja praznih naloga.
enum DoprinosStatus {
  ZABELEZEN
  EVIDENTIRAN
  PONISTEN // oglas uklonjen zbog povrede Uslova pre evidentiranja (čl. 40a st. 4)
}

/// Događaj koji je pretvorio zabeležen doprinos u zapis POEN-a (čl. 40a st. 3).
enum DoprinosOkidac {
  VERIFIKACIJA
  PRIMLJEN_POEN
  /// Verifikovan korisnik objavio kvalifikovan oglas — evidentira se odmah (čl. 40a st. 3).
  /// Ranije se zvao OBJAVA_VERIFIKOVAN; preimenovan 2026-08-11 (isto značenje).
  OBJAVA
  /// Fondacija odobrila prvi oglas naloga bez potvrde (čl. 40a st. 4) — glavni put
  /// do evidentiranja za neverifikovanog korisnika, admin tab „Prvi oglasi".
  ODOBRENJE
}

/// Doprinos sadržaju platforme — osmi kanal evidentiranja (Pravilnik čl. 15 t. 8,
/// čl. 40a). Korisniku se jednokratno evidentira 1.000 POEN-a za prvi oglas kojim
/// nudi dobro ili uslugu i koji ispunjava sadržinski minimum iz Uslova.
///
/// `userId` je @unique — jednokratnost kanala po čoveku obezbeđuje BAZA, ne kod.
/// Bez toga bi dve paralelne objave oglasa mogle da zabeleže dva doprinosa.
///
/// Evidentiranje je automatski akt Protokola i NE ulazi u dnevni limit (čl. 40a st. 5).
model DoprinosSadrzaju {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Oglas povodom kog je doprinos zabeležen. Ostaje i posle brisanja oglasa
  /// (SetNull) — činjenica doprinosa se ne gubi sa sadržajem.
  oglasId String?
  oglas   MarketplaceListing? @relation(fields: [oglasId], references: [id], onDelete: SetNull)

  iznos  Int             @default(1000)
  status DoprinosStatus  @default(ZABELEZEN)
  okidac DoprinosOkidac?

  /// Transakcija kojom je doprinos evidentiran u Protokolu (postoji tek u EVIDENTIRAN).
  transakcijaId String?

  zabelezenAt      DateTime  @default(now())
  evidentiranAt    DateTime?
  ponistenAt       DateTime?
  /// Kad je korisniku javljeno da mu je doprinos evidentiran. Odvojeno od
  /// `evidentiranAt` jer obaveštenje sme da zakasni (ili da se ponovi ručno),
  /// a zapis POEN-a ne sme da čeka na njega. Null uz EVIDENTIRAN = duguje se javljanje.
  obavestenAt      DateTime?
  /// Ko je okinuo evidentiranje — verifikator, odnosno pošiljalac POEN-a.
  /// Plain string (bez FK) — služi osmatranju obrasca iz odeljka 05, ne integritetu.
  okidacKorisnikId String?

  @@index([status])
  @@index([okidacKorisnikId, evidentiranAt])
}

// ─── Doprinos razmeni — putanja prvog kruga (čl. 40a, lestvica od 5 koraka) ───

/// Upit povodom oglasa — trag da se neko javio oglašivaču (korak 3 lestvice).
///
/// Nastaje kad verifikovani korisnik pokrene razgovor sa oglasnе stranice. Ne
/// čuva sadržaj poruke: za brojač je merodavna samo činjenica da se javio KO i
/// POVODOM ČEGA. Jedan upit po paru (oglas, pošiljalac) — ponovljeno javljanje
/// istom oglasu ne umnožava brojač.
model OglasUpit {
  id         String             @id @default(uuid())
  oglasId    String
  oglas      MarketplaceListing @relation(fields: [oglasId], references: [id], onDelete: Cascade)
  posiljacId String
  posiljac   User               @relation(fields: [posiljacId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@unique([oglasId, posiljacId])
  @@index([posiljacId])
}

/// Doprinos razmeni — koraci 2–5 putanje prvog kruga (Pravilnik čl. 40a).
///
/// Korak 1 (prvi oglas + prvi primljen POEN) je zatečeni doprinos sadržaju i vodi
/// se u `DoprinosSadrzaju` — OVDE GA NEMA. Zato je `korak` u opsegu 2–5, a
/// doživotna kapa od 5.000 POEN-a proizlazi iz zbira: 1.000 (čl. 40a, korak 1) +
/// 4 × 1.000 (ova tabela). Kapu drži BAZA, ne kod: `@@unique([userId, korak])` uz
/// ograničenje opsega znači da korisnik ne može imati više od četiri reda ovde.
model DoprinosRazmeni {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Redni broj koraka na lestvici (2–5).
  korak  Int
  iznos  Int            @default(1000)
  status DoprinosStatus @default(ZABELEZEN)

  /// Transakcija kojom je korak evidentiran u Protokolu (postoji tek u EVIDENTIRAN).
  transakcijaId String?

  zabelezenAt   DateTime  @default(now())
  evidentiranAt DateTime?
  /// Kad je korisniku javljeno. Isti razlog za odvajanje kao kod `DoprinosSadrzaju`:
  /// zapis POEN-a ne sme da čeka na mejl/push, a javljanje ne sme da ode dvaput.
  obavestenAt   DateTime?

  @@unique([userId, korak])
  @@index([status])
}

// Kategorije Pijace koje korisnik prati (čipovi u profilu). Pri objavi oglasa
// pratioci dobijaju obaveštenje — `emitujNoviOglas` u src/lib/oglas-dogadjaji.ts.
// Vrednost `category` je jedan od 13 slugova iz src/lib/kategorije.ts
// (validira se u API sloju).
model FollowedCategory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  createdAt DateTime @default(now())

  @@unique([userId, category])
  @@index([category])
}

model ProtokolProgram {
  type        ProgramType @id
  isActive    Boolean     @default(false)
  activatedAt DateTime?
  updatedAt   DateTime    @updatedAt
}

model ProgramEnrollment {
  id                    String           @id @default(uuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id])
  type                  ProgramType
  status                EnrollmentStatus @default(PENDING)
  metadata              Json?
  dailyAmount           Int?
  // Izričit pristanak da verifikatori budu zamoljeni da potvrde ispunjenost uslova
  // (Pravilnik o programima podrške čl. 4 — pravni osnov obrade je pristanak).
  pristanakVerifikatori Boolean          @default(false)
  approvedById          String?
  approvedAt            DateTime?
  rejectionReason       String?
  nextReverifikacija    DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  potvrde               ProgramPotvrda[]

  @@unique([userId, type])
  @@index([status, type])
}

// Potvrda verifikatora da prijavljeni korisnik ispunjava uslov socijalnog programa.
// Verifikator potvrđuje pod punom odgovornošću, na osnovu ličnog poznavanja osobe —
// NEMA uvid u osetljive prijavljene podatke (datumi rođenja dece, rešenje o
// invaliditetu i sl.), koji ostaju dostupni samo licu koje obrađuje prijavu (čl. 4).
// Odbijanje zahteva obrazloženje.
model ProgramPotvrda {
  id            String            @id @default(uuid())
  enrollmentId  String
  enrollment    ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  verifikatorId String
  verifikator   User              @relation("VerifikatorPotvrda", fields: [verifikatorId], references: [id])
  status        PotvrdaStatus     @default(CEKA)
  obrazlozenje  String?
  odgovorAt     DateTime?
  createdAt     DateTime          @default(now())

  @@unique([enrollmentId, verifikatorId])
  @@index([verifikatorId, status])
}

model DailyEmissionSummary {
  id             String   @id @default(uuid())
  date           DateTime @unique @db.Date
  opticaj        Int
  limit          Int
  totalRequested Int
  totalEmitted   Int
  koeficijent    Decimal  @db.Decimal(10, 6)
  breakdown      Json
  createdAt      DateTime @default(now())
}

// ─── Program Doprinosa Zajedničkom Dobru — Oglasi ─────────────────────────────

model DoprinosOglas {
  id             String            @id @default(uuid())
  title          String
  description    String
  source         OglasSource
  predlozeniPoen Int // predloženi POEN za potpuno izvršenje (čl. 5/6) — težinski koeficijent, nije garantovan iznos; 0 = bez ograničenja zbira dnevnih izvršenja
  obrazlozenje   String? // obrazloženje predloženog POEN-a (čl. 6)
  saOdobravanjem Boolean           @default(false) // čl. 14 — prijava primljena tek po izričitom odobrenju plana izvršenja
  positions      Int               @default(1)
  deadline       DateTime? // rok za prijavu
  status         OglasStatus       @default(ACTIVE)
  createdById    String
  createdBy      User              @relation("KreiraniOglasi", fields: [createdById], references: [id])
  krugId         String?
  krug           Krug?             @relation("KrugOglasi", fields: [krugId], references: [id])
  prijave        OglasPrijava[]
  evidencije     OglasEvidencija[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model OglasPrijava {
  id              String             @id @default(uuid())
  oglasId         String
  oglas           DoprinosOglas      @relation(fields: [oglasId], references: [id])
  userId          String
  user            User               @relation("OglasPrijave", fields: [userId], references: [id])
  planIzvrsenja   String? // plan izvršenja (čl. 11) — obavezan za zadatke „sa odobravanjem"
  status          OglasPrijavaStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  evidencije      OglasEvidencija[]
  createdAt       DateTime           @default(now())

  @@unique([oglasId, userId])
  @@index([status, oglasId])
}

model OglasEvidencija {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation("OglasEvidencije", fields: [userId], references: [id])
  oglasId        String
  oglas          DoprinosOglas    @relation(fields: [oglasId], references: [id])
  prijavaId      String
  prijava        OglasPrijava     @relation(fields: [prijavaId], references: [id])
  date           DateTime         @db.Date // dan na koji se odnosi izvršenje
  predlozeniPoen Int // predloženi POEN za ovo dnevno izvršenje (čl. 18) — težina u raspodeli
  amount         Int              @default(0) // evidentirani POEN nakon noćne raspodele (čl. 24); 0 dok nije obračunato
  dokaz          String? // link/opis dokaza izvršenja (čl. 18)
  description    String
  status         EvidencijaStatus @default(PENDING) // PENDING→APPROVED (potvrđeno, ulazi u raspodelu)→EMITTED / REJECTED
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@unique([userId, oglasId, date])
  @@index([date, status])
  @@index([status])
}

// ─── ZRNO sistem ─────────────────────────────────────────────────────────────

model ZrnoTrziste {
  id          String    @id @default("singleton")
  isActive    Boolean   @default(false)
  activatedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model ZrnoStanje {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  slobodno  Int      @default(0)
  aktivno   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ZrnoUpisZahtev {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  poenIznos    Int
  date         DateTime         @db.Date
  status       ZrnoZahtevStatus @default(PENDING)
  zrnaKupljeno Int?
  poenPlaceno  Int?
  createdAt    DateTime         @default(now())

  @@unique([userId, date])
  @@index([date, status])
}

model ZrnoOtpisZahtev {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  kolicina     Int
  date         DateTime         @db.Date
  status       ZrnoZahtevStatus @default(PENDING)
  poenDobijeno Int?
  createdAt    DateTime         @default(now())

  @@unique([userId, date])
  @@index([date, status])
}

model ZrnoStatusZahtev {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  kolicina  Int
  akcija    ZrnoStatusAkcija
  date      DateTime         @db.Date
  status    ZrnoZahtevStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([date, status])
}

model ZrnoDailyRate {
  date           DateTime @unique @db.Date
  kurs           Decimal  @db.Decimal(20, 2)
  protokolMinus  Int
  zrnaUProtokolu Int
  createdAt      DateTime @default(now())
}

model ZrnoDelegacija {
  id                String   @id @default(uuid())
  delegatorId       String   @unique
  delegator         User     @relation("Delegator", fields: [delegatorId], references: [id])
  delegatId         String?
  delegat           User?    @relation("Delegat", fields: [delegatId], references: [id])
  zakazaniDelegatId String?
  zakazaniDelegat   User?    @relation("ZakazaniDelegat", fields: [zakazaniDelegatId], references: [id])
  imaZakazano       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── Glasanje ─────────────────────────────────────────────────────────────────

model GlasanjePredlog {
  id               String           @id @default(uuid())
  title            String
  description      String
  authorId         String
  author           User             @relation(fields: [authorId], references: [id])
  vrsta            PredlogVrsta     @default(ODLUKA) // odluka (obavezujuća) ili dinarska preporuka (čl. 20)
  glasanjePocetak  DateTime // ponoć narednog obračunskog perioda (čl. 11)
  deadline         DateTime // kraj glasanja = kraj tog perioda
  status           PredlogStatus    @default(ACTIVE)
  ishodUsvojen     Boolean? // utvrđen po zatvaranju, prosta većina (čl. 8, 9, 13)
  zaZbir           Int? // zbir glasačke moći „za" u trenutku zatvaranja
  protivZbir       Int? // zbir glasačke moći „protiv" u trenutku zatvaranja
  izvrsenjeStatus  IzvrsenjeStatus? // postavlja se na ZA_IZVRSENJE kad je odluka usvojena (čl. 17)
  vetoObrazlozenje String? // obavezno obrazloženje zaštitnog veta (čl. 18)
  izvrsenoAt       DateTime?
  vetoAt           DateTime?
  uoOdgovor        UoOdgovor? // obrazložen odgovor UO na usvojenu preporuku (čl. 20)
  uoObrazlozenje   String?
  uoOdgovorAt      DateTime?
  glasovi          GlasanjeGlas[]
  nabavka          Nabavka?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model GlasanjeGlas {
  id              String          @id @default(uuid())
  predlogId       String
  predlog         GlasanjePredlog @relation(fields: [predlogId], references: [id])
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  /// Za/protiv glasanje (ODLUKA, DINARSKA_PREPORUKA). Null pri izbornom glasanju.
  za              Boolean?
  /// Izborno glasanje (IZBOR_NABAVKE): id naziva dobra za koji je glas dat.
  /// Null pri za/protiv glasanju. Tačno jedno od `za` i `izbor` je popunjeno.
  izbor           String?
  glasackaGlasova Int
  createdAt       DateTime        @default(now())

  @@unique([predlogId, userId])
  @@index([predlogId])
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation("AdminActions", fields: [adminId], references: [id])
  akcija    String
  targetId  String?
  detalji   String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// Dnevnik aktivnosti prijavljenih korisnika: koja stranica je otvorena i kada.
// Beleži se SAMO za prijavljene korisnike (gosti nikad); ponovna poseta iste
// stranice unutar 5 min se ne duplira. Retencija 12 meseci (GDPR cron —
// „tehnički logovi", Politika čl. 10). Vidljivo isključivo superadminu.
model AktivnostLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  putanja   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model DonationRecord {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  amountRSD       Decimal        @db.Decimal(12, 2)
  cumulativeRSD   Decimal        @db.Decimal(12, 2)
  level           Int
  poenEmitted     Int
  status          DonationStatus @default(PENDING)
  referenceNumber String?
  confirmedAt     DateTime?
  confirmedById   String?
  createdAt       DateTime       @default(now())

  // Kartično plaćanje (NestPay: Banca Intesa / OTP). RUCNO = klasična uplata
  // na račun koju admin ručno potvrđuje. KARTICA = naplata preko gateway-a.
  nacinUplate String  @default("RUCNO")
  provajder   String?
  oid         String? @unique
  bankRef     String?

  // Javna vs anonimna donacija (Pravilnik o pokroviteljstvu i donacijama, čl. 3,
  // 5a). Javna donacija (true) → ime i prezime donatora vidljivi u listi donacija
  // i evidentira se POEN. Anonimna (false) → bez imena i BEZ POEN-a.
  javno Boolean @default(true)

  // Ime i prezime donatora SNIMLJENO u trenutku evidentiranja javne donacije —
  // trajan zapis (kao i podaci o uplati), nezavisan od kasnijih izmena profila.
  // Lista donacija prikazuje upravo ovo polje. Null = anonimna ili istorijska
  // donacija (pre uvođenja pravila) → ne prikazuje se u listi.
  donatorIme String?

  @@index([status, createdAt])
}

// ─── Pokrovitelji ─────────────────────────────────────────────────────────────

model Pokrovitelj {
  id             String                    @id @default(uuid())
  naziv          String
  pib            String                    @unique
  adresa         String?
  kontaktEmail   String?
  kontaktTelefon String?
  vlasnikId      String
  vlasnik        User                      @relation("VlasnikP", fields: [vlasnikId], references: [id])
  kreiraoId      String
  kreirao        User                      @relation("AdminKreiraoP", fields: [kreiraoId], references: [id])
  rsdKumulativ   Decimal                   @default(0) @db.Decimal(12, 2)
  trenutniNivo   Int                       @default(0)
  status         String                    @default("ACTIVE") // ACTIVE | SUSPENDED
  doprinosi      PokroviteljDoprinos[]
  bonusiEmisije  PokroviteljBonusEmisija[]
  prijave        PokroviteljPrijava[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([vlasnikId])
  @@index([status])
}

// Prijava pokroviteljstva (čl. 7–9) — verifikovani korisnik pokreće evidenciju
// doprinosa pravnog lica; platforma generiše ugovor; po potvrdi Fondacije emituje
// se bonus POEN prema nivoima (čl. 10).
model PokroviteljPrijava {
  id             String                   @id @default(uuid())
  podnosilacId   String
  podnosilac     User                     @relation("PodnosilacPrijave", fields: [podnosilacId], references: [id])
  naziv          String
  pib            String
  vrstaDonacije  VrstaDonacije
  vrednostRsd    Decimal                  @db.Decimal(12, 2)
  cenovnikSlika  String?
  ugovorTekst    String
  status         PokroviteljPrijavaStatus @default(CEKA_POTPIS)
  potpisanoAt    DateTime?
  pokroviteljId  String?
  pokrovitelj    Pokrovitelj?             @relation(fields: [pokroviteljId], references: [id])
  potvrdioId     String?
  potvrdjenoAt   DateTime?
  odbijenoRazlog String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([podnosilacId])
  @@index([status])
}

model PokroviteljDoprinos {
  id            String        @id @default(uuid())
  pokroviteljId String
  pokrovitelj   Pokrovitelj   @relation(fields: [pokroviteljId], references: [id])
  rsdIznos      Decimal       @db.Decimal(12, 2)
  tip           VrstaDonacije
  evidentiraoId String
  evidentirao   User          @relation("EvidentiraoDoprinos", fields: [evidentiraoId], references: [id])
  napomena      String?
  createdAt     DateTime      @default(now())

  @@index([pokroviteljId, createdAt(sort: Desc)])
}

model PokroviteljBonusEmisija {
  id            String      @id @default(uuid())
  pokroviteljId String
  pokrovitelj   Pokrovitelj @relation(fields: [pokroviteljId], references: [id])
  vlasnikId     String
  vlasnik       User        @relation("PrimalacBonusa", fields: [vlasnikId], references: [id])
  nivo          Int
  bonusPoen     Int
  transactionId String?
  createdAt     DateTime    @default(now())

  @@index([pokroviteljId])
  @@index([vlasnikId])
}

model Notifikacija {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tip       String
  // `naslov`/`tekst` su UVEK popunjeni srpskim tekstom — i kao rezerva i zbog
  // starih redova koji nemaju ključ. Kad je `kljuc` postavljen, prikaz i mejl
  // sklapaju rečenicu iz prevoda na jeziku primaoca (vidi src/lib/prevod-servera.ts).
  naslov    String
  tekst     String
  /**
   * Ključ u messages/*.json (npr. "notifikacije.transfer_primljen").
   */
  kljuc     String?
  /**
   * Vrednosti za popunjavanje ({pseudonim}, {iznos}...).
   */
  parametri Json?
  procitana Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, procitana])
  @@index([userId, createdAt(sort: Desc)])
}

// Web Push pretplata uređaja (browser Push API). Jedan korisnik može imati više
// pretplata (više uređaja/browsera). `endpoint` je jedinstven po pretplati;
// `p256dh`/`auth` su ključevi za enkripciju payload-a (VAPID). Briše se kaskadno
// pri brisanju naloga, a i kad push servis vrati 404/410 (pretplata istekla).
model PushPretplata {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Konverzacija {
  id            String   @id @default(uuid())
  user1Id       String
  user2Id       String
  user1         User     @relation("KonvUser1", fields: [user1Id], references: [id])
  user2         User     @relation("KonvUser2", fields: [user2Id], references: [id])
  poruke        Poruka[]
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  /// Oglas sa kog je kliknuto „Kontaktiraj", a poruka još nije napisana.
  /// Čovek često otvori razgovor pa napiše tek kasnije, iz liste razgovora —
  /// zato povod čeka OVDE, a ne u adresi stranice. Troši ga prva poruka onoga
  /// ko nije vlasnik oglasa i prelazi na `Poruka.oglasId`.
  povodOglasId String?
  povodOglas   MarketplaceListing? @relation("KonvPovod", fields: [povodOglasId], references: [id], onDelete: SetNull)

  @@unique([user1Id, user2Id])
  @@index([user1Id, lastMessageAt(sort: Desc)])
  @@index([user2Id, lastMessageAt(sort: Desc)])
}

model Poruka {
  id             String       @id @default(uuid())
  konverzacijaId String
  konverzacija   Konverzacija @relation(fields: [konverzacijaId], references: [id])
  posiljacId     String
  posiljac       User         @relation("PorukePostavljene", fields: [posiljacId], references: [id])
  tekst          String
  procitana      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  /// Oglas povodom kog je poruka poslata. Konverzacija je jedna po PARU ljudi,
  /// pa povod ne može da stoji na njoj — isti dvoje se tokom vremena javljaju
  /// povodom više oglasa. SetNull: brisanje oglasa ne briše tuđu poruku.
  ///
  /// Odvojeno od `OglasUpit`, koji broji upite za korak 3: ovo je PRIKAZ u
  /// razgovoru (sličica i link), a ne merilo.
  oglasId String?
  oglas   MarketplaceListing? @relation("PorukaOglas", fields: [oglasId], references: [id], onDelete: SetNull)

  @@index([konverzacijaId, createdAt])
  @@index([oglasId])
}

// ─── Politika privatnosti — verzionisanje i pristanci ────────────────────────

model PolitikaVerzija {
  id          String                @id @default(uuid())
  verzija     String                @unique // npr. "1.0", "1.1"
  naslov      String
  efektivnaOd DateTime
  kreirao     String // adminId
  createdAt   DateTime              @default(now())
  pristanci   PolitikaPrihvatanje[]
}

model PolitikaPrihvatanje {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  verzijaId String
  verzija   PolitikaVerzija @relation(fields: [verzijaId], references: [id])
  prihvacen Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@unique([userId, verzijaId])
  @@index([userId])
}

// ─── Verzionisanje Pravilnika (paralelno sa Politikom, v3.7.0) ───────────────

model PravilnikVerzija {
  id          String                 @id @default(uuid())
  verzija     String                 @unique // npr. "3.7.0"
  naslov      String
  efektivnaOd DateTime
  kreirao     String // adminId
  createdAt   DateTime               @default(now())
  pristanci   PravilnikPrihvatanje[]
}

model PravilnikPrihvatanje {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  verzijaId String
  verzija   PravilnikVerzija @relation(fields: [verzijaId], references: [id])
  prihvacen Boolean          @default(true)
  createdAt DateTime         @default(now())

  @@unique([userId, verzijaId])
  @@index([userId])
}

// ─── Osnivacki doprinos (Pravilnik o osnivackom doprinosu v3.7.0) ────────────

model OsnivackiKanal {
  id                   String    @id @default("singleton")
  ukupnoEvidentirano   Int       @default(0) // ukupno POEN-a evidentirano kroz kanal (max 2.400.000)
  brojKoraka           Int       @default(0) // broj izvrsenih koraka (max 100)
  zatvoren             Boolean   @default(false) // postaje true kad brojKoraka = 120
  zatvorenAt           DateTime?
  poslednjiPrag        Int       @default(0) // posljednji aktiviran prag (100.000, 200.000, ...)
  osnivaciZakljucani   Boolean   @default(false) // admin zakljucao listu (uslov: zbir udela = 1); emisija ide samo kad je zakljucano
  osnivaciZakljucaniAt DateTime?
  updatedAt            DateTime  @updatedAt
}

model Osnivac {
  id           String                  @id @default(uuid())
  userId       String                  @unique
  user         User                    @relation("Osnivac", fields: [userId], references: [id])
  udeoBrojilac Int // npr. 50 (znaci 50/zbir)
  udeoImenilac Int // npr. 100 (znaci 50/100 = 50%)
  redniBroj    Int                     @unique // redosled u javnom registru
  napomena     String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  emisije      OsnivackiKorakEmisija[]
}

model OsnivackiKorakLog {
  id                 String                  @id @default(uuid())
  brojKoraka         Int                     @unique // 1, 2, ..., 100
  prag               Int // POEN prag koji je aktivirao korak (100k, 200k, ...)
  ukupanPoenUSistemu Int // total POEN-a u sistemu u trenutku okidanja
  iznosKoraka        Int                     @default(24000) // 24.000 POEN po koraku (v3.9.1)
  createdAt          DateTime                @default(now())
  emisije            OsnivackiKorakEmisija[]
}

model OsnivackiKorakEmisija {
  id            String            @id @default(uuid())
  korakLogId    String
  korakLog      OsnivackiKorakLog @relation(fields: [korakLogId], references: [id])
  osnivacId     String
  osnivac       Osnivac           @relation(fields: [osnivacId], references: [id])
  iznosPoen     Int // emitovano ovom osnivacu u ovom koraku
  transactionId String? // veza na Transaction
  createdAt     DateTime          @default(now())

  @@unique([korakLogId, osnivacId])
}

// ─── Fondacija — transparentnost sredstava i Zastitni veto (cl. 71) ──────────

enum FondacijaTrosakKategorija {
  PLATA
  INFRASTRUKTURA // hosting, domeni, serveri
  PRAVNI_TROSAK // advokati, sudski vestaci, registracije
  SOFTWARE // pretplate na alate, licence
  ADMINISTRATIVNO // bankarski troskovi, pisarnica, materijal
  OPERATIVNO // ostali operativni troskovi
  DRUGO
}

model FondacijaTrosak {
  id          String                    @id @default(uuid())
  datum       DateTime                  @db.Date
  iznosRSD    Decimal                   @db.Decimal(12, 2)
  kategorija  FondacijaTrosakKategorija
  opis        String
  dokumentUrl String? // link na racun/ugovor (opciono)
  kreiraoId   String
  kreirao     User                      @relation("KreiraoTrosak", fields: [kreiraoId], references: [id])
  createdAt   DateTime                  @default(now())

  @@index([datum])
  @@index([kategorija, datum])
}

model SistemskiVeto {
  id              String    @id @default("singleton")
  aktivan         Boolean   @default(false) // true kad Protokol < -1M I trajnoUgasen = false
  trajnoUgasen    Boolean   @default(false) // jednosmerni flag (cl. 71)
  datumAktivacije DateTime?
  datumGasenja    DateTime? // kada je trajnoUgasen postao true
  updatedAt       DateTime  @updatedAt
}

// ─── Prigovor na automatizovanu odluku ───────────────────────────────────────

enum PrigovorStatus {
  PENDING
  U_OBRADI
  RESENO
  ODBIJENO
}

model PrigovorNaOdluku {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  opis        String
  tipOdluke   String // "VERIFIKACIJA" | "SUSPENZIJA" | "PROGRAM" | "OSTALO"
  status      PrigovorStatus @default(PENDING)
  odgovor     String?
  odgovorioId String?
  odgovorioAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
}

// ─── Blog (Vesti Fondacije) ──────────────────────────────────────────────────

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  content     String
  authorId    String
  author      User     @relation("BlogAutor", fields: [authorId], references: [id])
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt(sort: Desc)])
}

// ─── Chat soba (globalna) ────────────────────────────────────────────────────

/// Soba Pričaonice. 🔴 Soba se NE BIRA nego se izvodi iz toga ko piše: maloletni
/// korisnik uvek dobija dečju, punoletni uvek sobu odraslih. Nema parametra kojim
/// bi se prešlo iz jedne u drugu — to je jedini način da se sigurno zna da odrasli
/// nisu u dečjoj sobi (Modul Deca, čl. 12).
enum ChatSoba {
  ODRASLI
  DECA
}

model ChatMessage {
  id             String          @id @default(uuid())
  soba           ChatSoba        @default(ODRASLI)
  userId         String
  user           User            @relation("ChatPoruke", fields: [userId], references: [id])
  content        String
  createdAt      DateTime        @default(now())
  // Uklanjanje od strane Fondacije (Uslovi čl. 25 st. 2 — obuhvata „svu drugu
  // komunikaciju putem Platforme"). Meko brisanje: poruka nestaje iz sobe, ali
  // ostaje trag ko je i zašto uklonio dok je noćni cron ne pobriše sa ostalima.
  uklonjenoAt    DateTime?
  uklonjenRazlog String?
  uklonioId      String?
  prijave        PrijavaPoruke[]

  @@index([soba, createdAt(sort: Desc)])
  @@index([userId])
}

// ─── Dokaz stvarnosti — graf verifikacija (Pravilnik v3.5.0) ─────────────────

model VerifikacionaVeza {
  id                 String           @id @default(uuid())
  verifikatorId      String
  verifikator        User             @relation("Verifikator", fields: [verifikatorId], references: [id])
  redniBroj          Int
  verifikovaniId     String
  verifikovani       User             @relation("Verifikovani", fields: [verifikovaniId], references: [id])
  vremenskiZig       DateTime         @default(now())
  // Slobodna oznaka (nadimak) koju verifikator dodeljuje verifikovanome — da bi lakše
  // pratio koga je verifikovao. NIJE javna: vidljiva samo verifikatoru i UO Fondacije
  // (admin). Ne objavljuje se drugim korisnicima i ne kači se na javnu evidenciju
  // doprinosa (Pravilnik o dokazu stvarnosti, dopuna 3.9.1; čl. 31).
  oznakaVerifikatora String?
  // Poslednji nadzornik i trenutak poslednjeg evidentiranog ishoda. Pun trag ide u
  // NadzorZapis — po ishodu "za proveru" zapis gleda više nadzornika, a jedno polje
  // ne može da nosi dvoje ljudi (dokaz stvarnosti 4.2.0, čl. 11).
  nadzornikId        String?
  nadzornik          User?            @relation("Nadzornik", fields: [nadzornikId], references: [id])
  podlezeNadzoru     Boolean
  nadzoranAt         DateTime?
  // Merodavan ishod = poslednji evidentirani. UREDNO je jedini koji dopunjava slot
  // kapaciteta verifikatora (čl. 11 st. 2 al. 1).
  nadzorIshod        NadzorIshod?
  nadzorZapisi       NadzorZapis[]
  nadzorniPredmet    NadzorniPredmet?

  @@unique([verifikatorId, redniBroj])
  // K6: isti verifikator ne sme dvaput da verifikuje istog korisnika (anti-inflacija
  // indeksa + zatvara race na anti-cirkularnoj proveri kod recipročnih/duplih veza).
  @@unique([verifikatorId, verifikovaniId])
  @@index([verifikatorId])
  @@index([verifikovaniId])
  @@index([nadzornikId])
}

// ─── Nadzor verifikacija — ishod i predmet (dokaz stvarnosti 4.2.0) ──────────
// Do 4.2.0 nadzornik je mogao samo da POTVRDI verifikaciju ili da ne uradi ništa —
// polja za "proverio sam i nešto ne štima" nije bilo, pa je podsticaj gurao ka
// propuštanju. Sada svaki nadzor ostavlja zabeležen ishod (čl. 11).

enum NadzorIshod {
  UREDNO // nema primedbi → dopunjava se slot kapaciteta verifikatora
  ZA_PROVERU // nadzorniku nije jasno → zapis ide drugom nadzorniku, slot se NE dopunjava
  SPORNO // nadzornik smatra da verifikacija nije istinita → slot se NE dopunjava
}

enum NadzorSubjekt {
  VERIFIKATOR
  VERIFIKOVANI
  OBA
  DEO_MREZE
}

enum NadzorniPredmetStatus {
  OTVOREN
  UTVRDJENA_LAZNA
  NEMA_OSNOVA
}

// Jedan red po nadzorniku po verifikaciji. `@@unique` je ono što tehnički sprovodi
// zabranu iz čl. 10 st. 4 — isti nadzornik ne sme dvaput da gleda isti zapis.
model NadzorZapis {
  id              String            @id @default(uuid())
  verifikacijaId  String
  verifikacija    VerifikacionaVeza @relation(fields: [verifikacijaId], references: [id], onDelete: Cascade)
  nadzornikId     String
  nadzornik       User              @relation("NadzorZapisi", fields: [nadzornikId], references: [id])
  ishod           NadzorIshod
  // Obavezni uz ZA_PROVERU i SPORNO, prazni uz UREDNO (čl. 11 st. 3).
  subjekt         NadzorSubjekt?
  razlog          String? // šifra sa liste iz čl. 11 st. 4
  opis            String? // samo uz razlog "ostalo"
  // 500 POEN ide PRVOM nadzorniku koji evidentira ishod, bez obzira koji je (čl. 7 st. 2).
  // Drugi ne dobija ništa — inače bi se isplatilo lančano dodavati nadzornike.
  poenEvidentiran Boolean           @default(false)
  createdAt       DateTime          @default(now())

  @@unique([verifikacijaId, nadzornikId])
  @@index([verifikacijaId])
  @@index([nadzornikId])
}

// Nadzorni predmet (čl. 11a). Alat, ne organ — odlučuje UO po čl. 18.
// Jedan po verifikaciji: drugi nadzornik koji doda ishod ažurira postojeći predmet.
// Vidi ga SAMO superadmin. Cascade je namerna: poništenjem verifikacije nestaje i
// predmet, a trag radnje ostaje u audit logu.
model NadzorniPredmet {
  id             String                @id @default(uuid())
  verifikacijaId String                @unique
  verifikacija   VerifikacionaVeza     @relation(fields: [verifikacijaId], references: [id], onDelete: Cascade)
  status         NadzorniPredmetStatus @default(OTVOREN)
  subjekt        NadzorSubjekt
  razlog         String
  opis           String?
  otvorenAt      DateTime              @default(now())
  resenById      String?
  resenBy        User?                 @relation("PredmetiReseni", fields: [resenById], references: [id])
  resenAt        DateTime?
  beleska        String?

  @@index([status, otvorenAt])
  @@index([resenById])
}

// ─── Zabranjena zona verifikacije (dokaz stvarnosti 3.9.2, čl. 12) ───────────
// Materijalizovana simetrična zabranjena zona: red (userId, forbiddenUserId)
// znači da userId NE SME da verifikuje forbiddenUserId (provera ide u OBA smera,
// čl. 12: "...niti korisnika u čijoj se zabranjenoj zoni sam nalazi").
// Ovo je KEŠ — izvor istine je tabela VerifikacionaVeza; celokupno stanje se
// deterministički izvodi iz grafa funkcijom recomputeZones (src/lib/protokol/zona.ts)
// i sinhronizuje u istoj transakciji sa svakim upisom, poništavanjem ili
// prestankom statusa. Skup je monoton pri upisu (unije), a pri poništavanju se
// NE oduzima inkrementalno (unija nije invertibilna) nego preračunava od nule.
model VerifikacionaZona {
  userId          String
  user            User   @relation("ZonaVlasnik", fields: [userId], references: [id], onDelete: Cascade)
  forbiddenUserId String
  forbiddenUser   User   @relation("ZonaZabranjeni", fields: [forbiddenUserId], references: [id], onDelete: Cascade)

  @@id([userId, forbiddenUserId])
  @@index([forbiddenUserId])
  @@map("verification_zone")
}

model VerifikacijaToken {
  id         String    @id @default(uuid())
  token      String    @unique
  brojCifara String    @unique
  korisnikId String
  korisnik   User      @relation(fields: [korisnikId], references: [id])
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  used       Boolean   @default(false)
  usedAt     DateTime?

  @@index([korisnikId])
  @@index([expiresAt])
}

// ─── Tabla zahteva za jemstvo ─────────────────────────────────────────────────
// Neverifikovan korisnik se predstavlja mreži verifikovanih radi uspostavljanja
// kontakta neophodnog za verifikaciju (čl. 32 Pravilnika, čl. 16 Uslova korišćenja).
//
// REDIZAJN „kartica prepoznavanja" — objava se više NE PIŠE kao slobodan tekst,
// nego se SASTAVLJA iz polja. Razlog: slobodan tekst se u praksi popunjavao kao
// oglas („bavim se pčelarstvom") — formalno validno, a niko ne može da prepozna
// osobu. Struktuirana polja + poznato mesto omogućavaju da sistem sam dovede
// kandidata onome ko ga najverovatnije poznaje (vidi Prepoznavanje).
//
// Sva polja kartice su OPCIONA (nikoga ne zaustavljamo na vratima), ali kartica
// bez `ime` + `mesto` NE ULAZI u feed — bez mesta se ne može nikome dovesti.
//
// `telefon` je SKRIVEN — nikad se ne prikazuje na kartici. Vidi ga isključivo
// UO, i to samo kad je `telefonSaglasnost` = true (svrha: da Fondacija pozove
// čoveka koga niko od članova nije prepoznao). Briše se kad korisnik bude
// verifikovan, kad objava istekne i kad se ukloni. Svaki pristup se loguje.

enum JemstvoStatus {
  AKTIVAN
  POVUCEN
  ISTEKAO
  UKLONJEN
  ZAVRSEN
  NEPOTPUN // legacy objava (slobodan tekst) — stoji na zidu, ne ulazi u feed
}

enum PrepoznavanjeOdgovor {
  DA
  NE
  NISAM_SIGURAN
}

model ZahtevZaJemstvo {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // ── Kartica prepoznavanja (vidljiva verifikovanom članu) ──
  ime        String?
  prezime    String?
  godiste    Int? // godina rođenja — razlikuje imenjake, nagoveštava generaciju
  mesto      String? // iz šifarnika NASELJA_SRBIJE (validira se na serveru)
  nadimak    String? // nadimak ili kućno ime — najjači signal u malim mestima
  cimeSeBavi String? // „čime se baviš / po čemu te znaju", max 100 znakova

  // ── Skriveni kontakt (nikad na kartici, vidi ga samo UO) ──
  telefon           String?
  telefonSaglasnost Boolean @default(false)

  // ── Legacy (redizajn): stari slobodan tekst se NE parsira automatski —
  //    pogrešno izvučeno ime je gore od nikakvog. Čuva se kao arhiva, a
  //    zahtev dobija status NEPOTPUN uz poziv vlasniku da dopuni karticu.
  //    `tekstPredstavljanja`/`kontaktPodaci` ostaju jedan ciklus radi povratka.
  legacyTekst         String?
  tekstPredstavljanja String?
  kontaktPodaci       String?

  status         JemstvoStatus @default(AKTIVAN)
  uklonjenRazlog String?
  createdAt      DateTime      @default(now())
  expiresAt      DateTime

  prepoznavanja Prepoznavanje[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([status, mesto]) // feed: kandidati iz istog mesta
}

// Odgovor verifikovanog člana na pitanje „Poznaješ li ovu osobu?".
// SVA TRI odgovora se upisuju — bez upisa „NE"/„NISAM_SIGURAN" feed bi vrteo
// iste ljude u krug. Odgovor DA otvara SAMO kanal komunikacije; formalni čin
// jemstva je zaseban akt (VerifikacionaVeza) i ova tabela ga NE zamenjuje.
model Prepoznavanje {
  id         String               @id @default(uuid())
  zahtevId   String
  zahtev     ZahtevZaJemstvo      @relation(fields: [zahtevId], references: [id], onDelete: Cascade)
  korisnikId String
  korisnik   User                 @relation(fields: [korisnikId], references: [id])
  odgovor    PrepoznavanjeOdgovor
  createdAt  DateTime             @default(now())

  @@unique([zahtevId, korisnikId])
  @@index([korisnikId])
}

// ─── Nadzor integriteta verifikacija (anti-malverzacija, 1. krug) ─────────────
// Noćni cron (/api/cron/nadzor-integriteta) računa pravila P1–P15 nad grafom
// verifikacija i tokom POEN-a i upisuje OBELEŽENE naloge/grupe ovde. Sistem
// NIKAD sam ne preduzima radnju — samo evidentira i (za HITNO) javi superadminu;
// gašenje uvek povlači čovek. `subjektId` je plain string (bez FK na User) da
// model ostane labavo spregnut. Status CISTO = superadmin odbacio kao lažnu uzbunu.
model RizikNalaz {
  id        String    @id @default(uuid())
  tip       String // "NALOG" | "GRUPA"
  subjektId String? // userId za NALOG; null za GRUPA
  pseudonim String? // za prikaz (NALOG)
  clanovi   String? // JSON [{id,pseudonim}] za GRUPA
  pravila   String // JSON [{kod,nivo,opis}]
  rizik     Int // ukupan skor (zbir težina pravila)
  nivo      String // najviši nivo: "INFO" | "UPOZORENJE" | "HITNO"
  status    String    @default("OTVOREN") // "OTVOREN" | "CISTO"
  resenById String?
  resenAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([status, rizik(sort: Desc)])
  @@index([subjektId])
}

// ─── Prijava bagova (greške na platformi) ─────────────────────────────────────
// Bilo koji prijavljen korisnik može da prijavi bag (grešku). Lista svih prijava
// je javna (vidljiva svim prijavljenima) zajedno sa statusom — da svako vidi šta
// je prijavljeno i da li se na tome radi. Status menja admin.

enum BugStatus {
  PRIJAVLJEN // prijavljeno, još se ne radi
  U_RADU // radi se na tome
  RESENO // ispravljeno
  ODBIJENO // nije bag / neće se raditi
}

model Bug {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation("PrijaviocBaga", fields: [userId], references: [id])
  naslov    String
  opis      String
  status    BugStatus @default(PRIJAVLJEN)
  odgovor   String? // beleška/odgovor admina (npr. zašto je odbijeno ili kad je rešeno)
  resenoAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
}

// ─── Modul Deca — prijateljstva ─────────────────────────────────────────────
//
// Maloletni korisnici se povezuju skeniranjem QR koda, uživo. Prijateljstvo je
// SIMETRIČNO: jedan red opisuje obe strane, pa se `aId` i `bId` upisuju sortirano
// (manji id prvi). Bez toga bi isti par mogao da uđe dvaput, u dva smera, i
// jedinstveni indeks ne bi ništa značio.
//
// ─── Zašto red ostaje i posle raskida ──────────────────────────────────────
//
// Raskinut par SME da se obnovi (čl. 14c st. 5) — pomirene drugarice ne gube
// ništa trajno. Kad bi se red brisao, `@@unique([aId, bId])` ne bi imao šta da
// čuva i isti par bi mogao da postoji dvaput. Zato se raskid beleži `raskinutAt`,
// a obnova ga vraća na `null`.
model Prijateljstvo {
  id           String    @id @default(uuid())
  aId          String
  a            User      @relation("PrijateljA", fields: [aId], references: [id], onDelete: Cascade)
  bId          String
  b            User      @relation("PrijateljB", fields: [bId], references: [id], onDelete: Cascade)
  // Da li je 500 POEN upisano OBEMA stranama (čl. 14b). Isplata čeka da obe strane
  // budu aktivne, pa red često stoji neisplaćen. Ovo polje je jedini izvor istine
  // o tome duguje li se otpis pri raskidu i pri punoletstvu — broj transakcija se
  // ne prebrojava unazad.
  poenIsplacen Boolean   @default(false)
  isplacenAt   DateTime?
  // Raskid (čl. 14c). Raskinuti može samo dete, bilo koje od dvoje; roditelj ne
  // može. `raskinuoId` je zato uvek jedna od dve strane.
  raskinutAt   DateTime?
  raskinuoId   String?
  raskinuo     User?     @relation("PrijateljstvoRaskinuo", fields: [raskinuoId], references: [id])
  createdAt    DateTime  @default(now())

  @@unique([aId, bId])
  @@index([aId])
  @@index([bId])
}

/// Prijava poruke iz Pričaonice — od 04.09.2026. samo iz sobe ODRASLIH (Uslovi
/// čl. 25). Dečja soba prijavu više nema (odluka vlasnika); zatečeni redovi iz nje
/// ostaju i admin ih i dalje rešava, pa servisni sloj sobu ne gleda.
///
/// Prijava ne uklanja poruku — uklanja je Fondacija, istim putem kao i svaki drugi
/// sadržaj (`DELETE /api/admin/chat/[id]`).
///
/// `@@unique([porukaId, prijaviocId])` — jedan korisnik, jedna prijava po poruci;
/// ponovljen pritisak nije nov podatak.
///
/// 🔴 Prijava nosi I PORUKU I ČOVEKA. Poruka je dokaz — bez nje bi Fondacija
/// morala da pročita celu sobu da bi shvatila šta se desilo, a to je upravo
/// nadzor koji je unapređeni model skinuo. `prijavljeniId` je autor poruke,
/// denormalizovan namerno: opasnost je gotovo uvek čovek, a tri prijave iz tri
/// razgovora nad istim nalogom su signal koji nijedna pojedinačna poruka ne nosi.
/// Denormalizacija je bezbedna jer se autor poruke ne menja.
model PrijavaPoruke {
  id            String              @id @default(uuid())
  porukaId      String
  poruka        ChatMessage         @relation(fields: [porukaId], references: [id], onDelete: Cascade)
  prijaviocId   String
  prijavioc     User                @relation("PrijaviocPoruke", fields: [prijaviocId], references: [id], onDelete: Cascade)
  /// Autor prijavljene poruke — subjekt prijave.
  prijavljeniId String
  prijavljeni   User                @relation("PrijavljeniPoruke", fields: [prijavljeniId], references: [id], onDelete: Cascade)
  /// Šifra sa zatvorene liste. Sedmogodišnjak neće napisati obrazloženje, ali ume
  /// da pritisne dugme — a šifra je uz to jedino po čemu se obrazac (mamljenje,
  /// laž o uzrastu) uopšte može prepoznati kroz više prijava.
  razlogKod     PrijavaPorukeRazlog @default(OSTALO)
  // Slobodan tekst, opcion — traži se samo uz šifru „ostalo".
  razlog        String?
  status        PrijavaOglasaStatus @default(OTVORENA)

  /// Obrazloženje odluke Fondacije — obavezno u oba ishoda, ide prijaviocu.
  odluka    String?
  resioId   String?
  resenAt   DateTime?
  createdAt DateTime  @default(now())

  @@unique([porukaId, prijaviocId])
  @@index([status, createdAt(sort: Desc)])
  @@index([prijavljeniId, createdAt(sort: Desc)])
}

// Jednokratni kod za povezivanje. 🔴 NEMA šestocifrenog broja, za razliku od koda
// za potvrdu stvarnosti — broj se može izdiktirati telefonom, a QR se mora POKAZATI.
// Zbog toga i kratko traje: kod koji živi satima može da se fotografiše i iskoristi
// daleko od deteta, a smisao je da se dvoje nađu jedno pored drugog.
model PrijateljToken {
  id         String   @id @default(uuid())
  token      String   @unique
  korisnikId String
  korisnik   User     @relation(fields: [korisnikId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  iskoriscen Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([korisnikId])
  @@index([expiresAt])
}

// ─── Projekti i kolektivne nabavke ───────────────────────────────────────────
// Pravilnik o KOLO sistemu čl. 14a i 51a; Pravilnik o projektima i kolektivnim
// nabavkama (set 4.4.1).

/// Rečnik naziva dobara. Zaseban model, a ne slobodan tekst na predlogu: bez
/// rečnika bi „gorivo", „dizel" i „gorivo za traktor" bili tri stavke za istu
/// stvar, registar bi se rasprašio i nijedan naziv nikad ne bi skupio dovoljno
/// korisnika da se o njemu glasa (čl. 9 st. 2).
model NazivDobra {
  id         String           @id @default(uuid())
  /// Prikazni oblik, onako kako ga je uneo prvi korisnik.
  naziv      String
  /// Ključ za poklapanje bez obzira na veličinu slova i razmake. Jedinstven —
  /// isti razlog kao `User.pseudonimLower`.
  nazivLower String           @unique
  kreiraoId  String?
  kreirao    User?            @relation("KreiraoNaziv", fields: [kreiraoId], references: [id])
  predlozi   PredlogNabavke[]
  nabavke    Nabavka[]
  createdAt  DateTime         @default(now())

  @@index([createdAt])
}

/// Predlog za nabavku — jedna reč, jedan po korisniku (čl. 9 st. 3).
/// Jednokratnost drži BAZA (`userId @unique`), ne kod: nov predlog zamenjuje
/// raniji, pa je registar „jedan član — jedan glas o predmetu".
model PredlogNabavke {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nazivId   String
  naziv     NazivDobra @relation(fields: [nazivId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  // Registar grupiše po nazivu i broji različite korisnike.
  @@index([nazivId])
}

enum NabavkaStatus {
  NACRT // Fondacija prikuplja ponude, kalkulacija još nije objavljena
  OBJAVLJENA // kalkulacija objavljena, prijave otvorene (3 dana)
  RED_UTVRDJEN // prijave zatvorene, red snimljen, pozivi za potvrdu teku
  PLACENA // dobavljaču plaćeno, period preuzimanja teče (3 dana)
  ZAVRSENA
  OBUSTAVLJENA
}

enum NabavkaPrijavaStatus {
  PRIJAVLJEN // u redu, čeka poziv
  POZVAN // poziv poslat, teče rok za odgovor (3 dana)
  POTVRDIO // upisao dan preuzimanja, POEN rezervisan
  PREUZEO // POEN poništen protivzapisom
  ODUSTAO
  ISTEKAO // nije odgovorio na poziv u roku
  NIJE_PREUZEO // potvrdio, ali nije došao upisanog dana
}

/// Jedna kolektivna nabavka, od izbora predmeta do preuzimanja.
/// Svi brojevi kalkulacije se SNIMAJU na zapis u trenutku objave (čl. 20 st. 2:
/// kalkulacija se posle objave ne menja). Bez snimka bi se prikazana kalkulacija
/// menjala kad se promeni saldo Fondacije ili maloprodajna cena.
model Nabavka {
  id      String        @id @default(uuid())
  nazivId String
  naziv   NazivDobra    @relation(fields: [nazivId], references: [id])
  status  NabavkaStatus @default(NACRT)

  /// Glasanje kojim je predmet izabran (čl. 12). Null za nabavku koju je UO
  /// pokrenuo pre konstituisanja Gornjeg Kola.
  glasanjePredlogId String?          @unique
  glasanjePredlog   GlasanjePredlog? @relation(fields: [glasanjePredlogId], references: [id])

  // ── Sredstva (čl. 5 i 8) — snimak u trenutku objave
  saldoSnimak   Decimal? @db.Decimal(12, 2)
  rezervaSnimak Decimal? @db.Decimal(12, 2)
  iznosNabavke  Decimal? @db.Decimal(12, 2)

  // ── Ponuda i kalkulacija (čl. 15, 17, 18, 19)
  dobavljac    String?
  jedinicaMere String? // „vreća 25 kg" — samo za prikaz
  nabavnaCena  Decimal? @db.Decimal(12, 2)
  /// Maloprodajna referenca u celim dinarima; ujedno POEN po jedinici (paritet 1:1).
  maloprodajna Int?
  izvoriCena   String?
  brojJedinica Int?
  brojDelova   Int?
  velicinaDela Int?
  poenPoDelu   Int?

  // ── Rokovi (čl. 21, 23, 26)
  prijaveDo        DateTime?
  mestoPreuzimanja String?
  preuzimanjeOd    DateTime?
  preuzimanjeDo    DateTime?

  objavljenoAt DateTime?
  redUtvrdjenAt DateTime?
  placenoAt    DateTime?
  placenoRSD   Decimal?  @db.Decimal(12, 2)
  zavrsenoAt   DateTime?
  obustavljenoAt DateTime?
  obustavaRazlog String?

  ponude  NabavkaPonuda[]
  prijave NabavkaPrijava[]
  trosak  ProjekatTrosak?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([nazivId])
}

/// Prikupljena ponuda (čl. 15). Objavljuju se SVE, i one koje nisu izabrane —
/// bez toga „najpovoljnija" nije provera nego tvrdnja.
model NabavkaPonuda {
  id             String   @id @default(uuid())
  nabavkaId      String
  nabavka        Nabavka  @relation(fields: [nabavkaId], references: [id], onDelete: Cascade)
  ponudjac       String
  cenaPoJedinici Decimal  @db.Decimal(12, 2)
  izabrana       Boolean  @default(false)
  napomena       String?
  createdAt      DateTime @default(now())

  @@index([nabavkaId])
}

/// Prijava korisnika na nabavku i njegovo mesto u redu.
model NabavkaPrijava {
  id        String               @id @default(uuid())
  nabavkaId String
  nabavka   Nabavka              @relation(fields: [nabavkaId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    NabavkaPrijavaStatus @default(PRIJAVLJEN)

  /// 🔴 SNIMAK broja POEN-a u trenutku isteka roka za prijavu (čl. 22 st. 2).
  /// Red mora biti snimak, ne živa vrednost: rolanje poziva traje danima, a ljudi
  /// u međuvremenu troše POEN — pri živom rangiranju red bi se premeštao pod
  /// nogama onima koji čekaju poziv.
  poenSnimak Int?
  /// Mesto u redu, 1 = prvi. Utvrđuje se zajedno sa snimkom.
  mesto      Int?

  pozvanAt       DateTime?
  potvrdjenoAt   DateTime?
  danPreuzimanja DateTime?
  /// Kod koji korisnik pokazuje dobavljaču. Dobavljač dobija SAMO spisak kodova —
  /// nikad pseudonim ni bilo koji drugi podatak o licu (čl. 26 st. 3).
  kod            String?   @unique
  preuzetoAt     DateTime?

  /// Rezervisan POEN dok traje potvrda. Nula kad nema rezervacije — Novčanik red
  /// prikazuje samo kad postoji.
  rezervisano Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Jedna prijava po korisniku po nabavci — brana drži baza, ne kod.
  @@unique([nabavkaId, userId])
  @@index([nabavkaId, status])
  @@index([nabavkaId, mesto])
  @@index([userId])
}

/// Dinarski odliv u projekat.
///
/// 🔴 NE ide u `FondacijaTrosak`. `dohvatiTrosakPrethodnogMeseca()` sabira sve
/// redove tog modela, a `pragZaGasenje = trosak × 3` — nabavka od 200.000 RSD
/// podigla bi prag za 600.000 RSD, pa bi se zaštitni veto najteže gasio baš u
/// mesecima kada Fondacija najviše radi. Saldo se umanjuje i za projekte
/// (`dohvatiSaldoFondacije`), ali prag meri SAMO operativu.
model ProjekatTrosak {
  id        String   @id @default(uuid())
  nabavkaId String?  @unique
  nabavka   Nabavka? @relation(fields: [nabavkaId], references: [id])
  datum     DateTime @db.Date
  iznosRSD  Decimal  @db.Decimal(12, 2)
  opis      String
  kreiraoId String
  kreirao   User     @relation("KreiraoProjekatTrosak", fields: [kreiraoId], references: [id])
  createdAt DateTime @default(now())

  @@index([datum])
}
